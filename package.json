{
  "name": "broadcast-schedule-maker",
  "version": "1.6.1",
  "description": "스트리머 방송 시간표 제작 프로그램",
  "author": "llipp9983",
  "license": "MIT",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/llipp9983/broadcast-schedule-maker",
  "repository": {
    "type": "git",
    "url": "https://github.com/llipp9983/broadcast-schedule-maker.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.llipp9983.broadcastschedule",
    "electronLanguages": ["ko", "en-US"],
    "productName": "방송시간표 메이커",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "llipp9983",
        "repo": "broadcast-schedule-maker"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "BroadcastScheduleMaker-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BroadcastScheduleMaker-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "electron-updater": "^6.8.11",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  }
}